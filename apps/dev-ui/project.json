{
  "name": "dev-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/dev-ui/src",
  "projectType": "application",
  "targets": {
    "build":     { "executor": "nx:run-commands", "dependsOn": ["^build"], "options": { "command": "npm run build", "cwd": "apps/dev-ui" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "npm run typecheck", "cwd": "apps/dev-ui" } },
    "lint":      { "executor": "nx:run-commands", "options": { "command": "npm run lint", "cwd": "apps/dev-ui" } }
  }
}
