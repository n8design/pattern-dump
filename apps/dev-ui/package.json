{
  "name": "@pattern-dump/dev-ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "The Pattern Dump workbench: Nav Rail, Stage, Inspector and Console in the browser.",
  "dependencies": {
    "@pattern-dump/contracts": "*"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --outfile=dist/main.js --loader:.html=text && sass src/styles/shell.scss dist/main.css --no-source-map",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:css": "stylelint 'src/styles/**/*.scss'",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  }
}
