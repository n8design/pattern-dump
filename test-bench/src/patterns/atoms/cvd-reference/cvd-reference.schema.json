{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CVD reference card",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "hex":  { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
