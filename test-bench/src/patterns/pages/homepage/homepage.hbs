<div class="page-homepage">
  <header class="page-header">
    <h1>{{title}}</h1>
    <p class="page-subtitle">{{subtitle}}</p>
  </header>
  <main class="page-body">
    <section class="page-section">
      <h2>{{section.heading}}</h2>
      <p>{{section.body}}</p>
    </section>
  </main>
  <footer class="page-footer">
    <p>{{footer}}</p>
  </footer>
</div>
