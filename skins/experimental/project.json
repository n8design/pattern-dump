{
  "name": "skin-experimental",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "skins/experimental"
      },
      "dependsOn": [
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "build",
        {
          "projects": [
            "cli",
            "dev-server"
          ],
          "target": "build"
        }
      ]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run e2e",
        "cwd": "skins/experimental"
      },
      "dependsOn": [
        "build",
        {
          "projects": [
            "cli",
            "dev-ui"
          ],
          "target": "build"
        }
      ],
      "cache": false
    }
  }
}
