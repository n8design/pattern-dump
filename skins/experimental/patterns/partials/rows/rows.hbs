{{#if sections}}
<nav class="site-rows" aria-label="Sections">
  <ol class="rows">
    {{#each (skinSections nav)}}
    <li class="row">
      <a class="row-title" href="{{route}}"><span class="row-number">({{number}})</span> {{title}}</a>
      {{#if description}}<p class="row-description">{{description}}</p>{{/if}}
      {{#if children}}
      <ul class="row-pages">
        {{#each children}}<li><a href="{{route}}">{{title}}</a></li>{{/each}}
      </ul>
      {{/if}}
    </li>
    {{/each}}
  </ol>
</nav>
{{else}}
{{#with (skinSectionPages nav)}}{{#if length}}
<nav class="site-rows" aria-label="In this section">
  <ol class="rows">
    {{#each this}}
    <li class="row">
      <a class="row-title" href="{{route}}"><span class="row-number">({{number}})</span> {{title}}</a>
      {{#if description}}<p class="row-description">{{description}}</p>{{/if}}
    </li>
    {{/each}}
  </ol>
</nav>
{{/if}}{{/with}}
{{/if}}
