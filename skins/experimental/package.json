{
  "name": "@pattern-dump/skin-experimental",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental: a storefront skin for Pattern Dump, as a pattern package. Ink, bone and vermilion, poster titles, chapter rows and specimen plates.",
  "type": "module",
  "license": "MIT",
  "patternDump": {
    "patterns": "patterns",
    "helpers": "dist/helpers/skin.js",
    "scripts": "scripts",
    "assets": [
      "assets/skin-experimental"
    ],
    "styles": {
      "dir": "styles",
      "documentBase": [
        "site"
      ]
    }
  },
  "devDependencies": {
    "@pattern-dump/cli": "*"
  },
  "scripts": {
    "build": "esbuild helpers/skin.ts --bundle --platform=node --format=esm --outfile=dist/helpers/skin.js",
    "watch:helpers": "esbuild helpers/skin.ts --bundle --platform=node --format=esm --outfile=dist/helpers/skin.js --watch",
    "dev": "cd demo && node ../../../packages/cli/dist/index.js dev",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint helpers scripts test e2e",
    "lint:css": "stylelint 'styles/**/*.scss' 'demo/src/styles/**/*.scss'"
  }
}
