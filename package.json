{
  "name": "pattern-dump",
  "version": "0.0.0",
  "private": true,
  "description": "A workbench for HTML and CSS design systems: live component previews, docs, checks and static publishing.",
  "author": {
    "name": "Stefan Bauer (N8D e.U.)",
    "email": "stefan.bauer@n8d.at",
    "url": "https://n8d.at"
  },
  "license": "MIT",
  "homepage": "https://pattern-dump.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8design/pattern-dump.git"
  },
  "bugs": "https://github.com/n8design/pattern-dump/issues",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stfbauer"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/n8design"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "test-bench",
    "storefront-bench",
    "package-bench",
    "mounts-bench",
    "skins/*"
  ],
  "scripts": {
    "build": "nx run-many -t build --outputStyle=static",
    "test": "nx run-many -t test --outputStyle=static",
    "lint": "nx run-many -t lint --outputStyle=static",
    "typecheck": "nx run-many -t typecheck --outputStyle=static",
    "e2e": "nx run dev-ui:e2e --outputStyle=static",
    "e2e:storefront": "nx run storefront-bench:e2e --outputStyle=static",
    "e2e:package-bench": "nx run package-bench:e2e --outputStyle=static",
    "dev:check": "node scripts/check-server-fresh.mjs",
    "test:scripts": "node --test scripts/ci/burn-in.test.mjs scripts/no-em-dash.test.mjs scripts/e2e-specs.test.mjs scripts/commitlint.test.mjs scripts/changelog.test.mjs scripts/changelog-density.test.mjs scripts/golden-check.test.mjs",
    "burn-in": "node scripts/ci/burn-in.mjs",
    "pack:pd": "npm run build && node packages/cli/scripts/pack.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "graph": "nx graph",
    "affected": "nx affected -t build test lint typecheck --outputStyle=static",
    "dev": "npm run dev --workspace test-bench",
    "prepare": "husky",
    "e2e:skin-experimental": "nx run skin-experimental:e2e --outputStyle=static",
    "e2e:mounts": "nx run mounts-bench:e2e --outputStyle=static"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.60.0",
    "autoprefixer": "^10.7.0",
    "axe-core": "4.11.4",
    "chokidar": "^3.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "handlebars": "^4.7.10",
    "husky": "^9.1.7",
    "nx": "^24.0.7",
    "pagefind": "^1.6.0",
    "postcss": "^8.5.33",
    "sass": "^1.108.2",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "ws": "^8.23.0"
  },
  "overrides": {
    "playwright-core": "1.60.0"
  }
}
