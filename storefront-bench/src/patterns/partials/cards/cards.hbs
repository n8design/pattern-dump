{{#if sections}}
<nav class="site-cards" aria-label="Sections">
  <ul class="cards">
    {{#each nav}}{{#unless current}}
    <li class="card">
      <div class="card-body">
        <a class="card-title" href="{{route}}">{{title}}</a>
        {{#if children}}
        <ul class="card-pages">
          {{#each children}}<li><a href="{{route}}">{{title}}</a></li>{{/each}}
        </ul>
        {{/if}}
      </div>
    </li>
    {{/unless}}{{/each}}
  </ul>
</nav>
{{else}}
{{#each nav}}{{#if current}}{{#if children}}
<nav class="site-cards" aria-label="In this section">
  <ul class="cards">
    {{#each children}}
    <li class="card">
      <div class="card-body">
        <a class="card-title" href="{{route}}">{{title}}</a>
      </div>
    </li>
    {{/each}}
  </ul>
</nav>
{{/if}}{{/if}}{{/each}}
{{/if}}
