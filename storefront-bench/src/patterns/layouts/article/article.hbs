{{#> partials-base }}
<article class="article">
  <header class="article-header">
    <h1 class="article-title" style="--sk-chars: {{title.length}}">{{title}}</h1>
    {{#if lede}}<p class="article-lede">{{lede}}</p>{{/if}}
  </header>
  <div class="article-body">{{{body}}}</div>
</article>
{{/partials-base}}
