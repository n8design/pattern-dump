{{#> partials-base }}
<article class="article">
  <header class="hero">
    <h1 class="hero-title article-title" style="--sk-chars: {{skinLongestWord title}}">{{title}}</h1>
  </header>
  <dl class="hero-meta">
    <div><dt>Index</dt><dd>{{skinIndex nav}}</dd></div>
    <div><dt>Layout</dt><dd>article</dd></div>
    <div><dt>Sections</dt><dd>{{#with (skinChapters body)}}{{count}}{{/with}}</dd></div>
  </dl>
  {{#if lede}}<p class="article-lede">{{lede}}</p>{{/if}}
  <div class="article-body">{{{body}}}</div>
</article>
{{/partials-base}}
