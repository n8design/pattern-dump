{{#> partials-base }}
<article class="page">
  <header class="page-header">
    <h1 class="page-title" style="--sk-chars: {{title.length}}">{{title}}</h1>
    {{#if description}}<p class="page-description">{{description}}</p>{{/if}}
  </header>
  <div class="page-body">{{{body}}}</div>
  {{> partials-cards }}
</article>
{{/partials-base}}
