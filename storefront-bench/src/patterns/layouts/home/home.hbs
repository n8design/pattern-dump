{{#> partials-base }}
<article class="home">
  <h1 class="page-title">{{title}}</h1>
  {{#if description}}<p class="page-description">{{description}}</p>{{/if}}
  <div class="page-body">{{{body}}}</div>
  {{#if page.latest.entries.length}}
  <section class="home-latest" aria-labelledby="home-latest-title">
    <h2 id="home-latest-title">Latest articles</h2>
    <ul>
      {{#each page.latest.entries}}
      <li><a href="{{route}}">{{title}}</a>{{#if date}} <time datetime="{{date}}">{{dateText}}</time>{{/if}}</li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
</article>
{{/partials-base}}
