{
  "name": "storefront-bench",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "storefront-bench"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run e2e",
        "cwd": "storefront-bench"
      },
      "dependsOn": [
        {
          "projects": [
            "cli",
            "dev-ui"
          ],
          "target": "build"
        }
      ],
      "cache": false
    }
  }
}
