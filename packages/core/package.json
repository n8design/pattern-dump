{
  "name": "@pattern-dump/core",
  "version": "0.0.0",
  "private": true,
  "description": "Command orchestration for the CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@pattern-dump/config": "*",
    "@pattern-dump/dev-server": "*",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --external:@pattern-dump/* --outfile=dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  }
}
