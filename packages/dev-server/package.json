{
  "name": "@pattern-dump/dev-server",
  "version": "0.0.0",
  "private": true,
  "description": "The integrator: the dev server, the corpus audit, the static build and export.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@pattern-dump/a11y": "*",
    "@pattern-dump/build": "*",
    "@pattern-dump/config": "*",
    "@pattern-dump/contracts": "*",
    "@pattern-dump/discovery": "*",
    "@pattern-dump/hotreloader": "*",
    "@pattern-dump/renderer": "*",
    "axe-core": "^4.9.0",
    "chokidar": "^3.6.0",
    "markdown-it": "^14",
    "node-html-parser": "^7.1.0",
    "postcss": "^8.0.0",
    "sass": "^1.77.0",
    "source-map": "^0.6.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --external:@pattern-dump/* --outfile=dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  }
}
