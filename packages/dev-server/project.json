    "lint":      { "executor": "nx:run-commands", "options": { "command": "npm run lint", "cwd": "packages/dev-server" } },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "npm run typecheck", "cwd": "packages/dev-server" } }
  }
}
