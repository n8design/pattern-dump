{
  "name": "dev-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dev-server/src",
  "projectType": "library",
  "targets": {
    "build":     { "executor": "nx:run-commands", "options": { "command": "npm run build", "cwd": "packages/dev-server" } },
