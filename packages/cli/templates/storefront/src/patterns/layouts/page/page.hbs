{{#> partials-base }}
<article class="page">
  <h1 class="page-title">{{title}}</h1>
  {{#if description}}<p class="page-description">{{description}}</p>{{/if}}
  {{#if page.date}}<div class="page-meta"><time datetime="{{page.date}}">{{page.date}}</time>{{#if page.tags.length}}<ul class="page-tags" aria-label="Tags">{{#each page.tags}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</div>{{/if}}
  <div class="page-body">{{{body}}}</div>
  {{#if page.next}}<p class="page-next"><a rel="next" href="{{page.next.route}}">Next: {{page.next.title}}</a></p>{{/if}}
</article>
{{/partials-base}}
