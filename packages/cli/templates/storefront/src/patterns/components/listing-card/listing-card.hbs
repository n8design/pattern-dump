<article class="listing-card">
  <h2 class="listing-card-title"><a href="{{route}}">{{title}}</a></h2>
  {{#if date}}<p class="listing-card-date"><time datetime="{{date}}">{{dateText}}</time></p>{{/if}}
  {{#if description}}<p class="listing-card-teaser">{{description}}</p>{{/if}}
  {{#if tags.length}}<ul class="listing-card-tags" aria-label="Tags">{{#each tags}}<li>{{#if route}}<a href="{{route}}">{{label}}</a>{{else}}{{label}}{{/if}}</li>{{/each}}</ul>{{/if}}
</article>
