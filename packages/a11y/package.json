{
  "name": "@pattern-dump/a11y",
  "version": "0.0.0",
  "private": true,
  "description": "Accessibility checks: axe-core rule tiers and the structural producer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@pattern-dump/contracts": "*",
    "axe-core": "4.14.1",
    "jsdom": "27.4.0"
  },
  "devDependencies": {
    "@types/jsdom": "*"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/page-worker.ts --bundle --platform=node --format=esm --packages=external --external:@pattern-dump/* --outdir=dist",
    "classify": "esbuild src/classifier.ts --bundle --platform=node --format=esm --packages=external --external:@pattern-dump/* --outfile=dist/classifier.js && node dist/classifier.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "classify-pages": "esbuild src/classify-pages.ts --bundle --platform=node --format=esm --packages=external --external:@pattern-dump/* --outfile=dist/classify-pages.js && node dist/classify-pages.js"
  }
}
